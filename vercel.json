{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/telegram.mjs": {
      "maxDuration": 10
    },
    "api/setup.mjs": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/referral?code=:code"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
