{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/telegram.mjs": {
      "maxDuration": 10
    },
    "api/setup.mjs": {
      "maxDuration": 10
    },
    "api/automation/run.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/r/:code",
      "destination": "/api/referral?code=:code"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/automation/run",
      "schedule": "10 * * * *"
    }
  ]
}
